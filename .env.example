# Use independently generated values. Never reuse a provider API key.
UBIQUUM_MASTER_KEY=replace-with-a-random-operator-key

# SHA-256 of the password used for the embedded management console.
# macOS: printf '%s' 'your password' | shasum -a 256
# Linux: printf '%s' 'your password' | sha256sum
UBIQUUM_ADMIN_PASSWORD_SHA256=
